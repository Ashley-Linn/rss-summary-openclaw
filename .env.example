# ========== 模式选择 ==========
# true: 使用 FreshRSS 聚合源； false: 使用独立 URL 列表
USE_FRESHRSS=true

# ========== 模式A：统一聚合模式 ==========
# FreshRSS 聚合源 URL（带 token，示例格式）
FRESHRSS_URL=http://localhost:8080/feeds/你的用户名/你的token?hours=24
# 是否启用白名单筛选（true=只输出关注的源，false=全量）
FILTER_MODE=true
# 白名单关键词（JSON数组，支持域名或 feed ID）
FOCUS_FEATURES_JSON=["chinanews.com.cn","qbitai.com","36kr.com","MP_WXS_3911350320"]

# ========== 模式B：直接抓取模式 ==========
# 直接抓取的 RSS 源列表（JSON数组）
DIRECT_FEED_URLS_JSON=["https://www.qbitai.com/feed","https://36kr.com/feed"]

# ========== 飞书配置 ==========
FEISHU_APP_ID=cli_xxxx
FEISHU_APP_SECRET=xxxx
FEISHU_USER_OPEN_ID=ou_xxxx

# ========== DeepSeek API ==========
DEEPSEEK_API_KEY=sk-xxxx

# ========== Obsidian 归档（可选） ==========
# WSL 中访问 Windows 路径的格式，例如 /mnt/d/MyNotes/Obsidian
OBSIDIAN_VAULT_PATH=/mnt/d/MyNotes/Obsidian

# ========== 其他 ==========
# 最多获取文章数量
MAX_ARTICLES=10